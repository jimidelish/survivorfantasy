# Copy this file to .env.local for local development,
# and add the same three values in Vercel under Project Settings > Environment Variables.

# Found in Supabase: Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Found in Supabase: Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Found in Supabase: Project Settings > API > Project API keys > service_role
# NEVER expose this in client code. It is only read on the server (API routes).
SUPABASE_SERVICE_ROLE_KEY=
